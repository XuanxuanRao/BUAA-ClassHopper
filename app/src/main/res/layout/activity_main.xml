<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".activity.MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/home_background"
        android:fitsSystemWindows="true">

        <ScrollView
            android:id="@+id/homeScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_hero_gradient"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="28dp">

                    <ImageButton
                        android:id="@+id/hamburger_button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_home_icon_button"
                        android:contentDescription="打开侧边栏"
                        android:padding="12dp"
                        android:src="@drawable/ic_home_menu"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageButton
                        android:id="@+id/scanButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_home_icon_button"
                        android:contentDescription="扫码"
                        android:padding="12dp"
                        android:src="@drawable/ic_home_scan"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/userInfoTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:background="@drawable/bg_home_status_chip"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp"
                        android:text="学号 姓名"
                        android:textColor="@color/home_text_on_hero"
                        android:textSize="15sp"
                        app:layout_constraintEnd_toStartOf="@id/webSocketStatusGroup"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/hamburger_button" />

                    <LinearLayout
                        android:id="@+id/webSocketStatusGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:background="@drawable/bg_home_status_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/scanButton">

                        <ImageView
                            android:id="@+id/webSocketStatusIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="WebSocket 未连接"
                            android:src="@android:drawable/presence_offline"
                            app:tint="@color/ws_disconnected" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="实时状态"
                            android:textColor="@color/home_text_on_hero"
                            android:textSize="12sp" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_home_query_card"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_home_input"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_centerVertical="true"
                                android:contentDescription="学号"
                                android:src="@drawable/ic_home_student" />

                            <EditText
                                android:id="@+id/editTextId"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="34dp"
                                android:background="@android:color/transparent"
                                android:gravity="center_vertical"
                                android:hint="请输入学号"
                                android:inputType="textVisiblePassword"
                                android:paddingStart="0dp"
                                android:paddingEnd="0dp"
                                android:textColor="@color/home_text_primary"
                                android:textColorHint="@color/home_text_secondary" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/datePickerContainer"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_home_input"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp">

                            <ImageView
                                android:id="@+id/calendarIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_centerVertical="true"
                                android:contentDescription="选择日期"
                                android:src="@drawable/ic_home_calendar" />

                            <TextView
                                android:id="@+id/textViewDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="34dp"
                                android:background="@android:color/transparent"
                                android:clickable="false"
                                android:focusable="false"
                                android:gravity="center_vertical"
                                android:includeFontPadding="false"
                                android:paddingStart="0dp"
                                android:paddingEnd="0dp"
                                android:textColor="@color/home_text_primary"
                                android:textColorHint="@color/home_text_secondary"
                                android:textSize="15sp"
                                tools:text="2026-05-05" />
                        </RelativeLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGetClass"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_home_primary_button"
                        android:text="查询课程"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_home_result_card"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_home_course" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="课程列表"
                            android:textColor="@color/home_text_primary"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <TableLayout
                        android:id="@+id/tableLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:stretchColumns="*">

                        <TableRow
                            android:background="@color/home_table_header"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="课程名称"
                                android:textColor="@color/home_table_text"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="时间"
                                android:textColor="@color/home_table_text"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.75"
                                android:text="教室"
                                android:textColor="@color/home_table_text"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.75"
                                android:text="签到"
                                android:textColor="@color/home_table_text"
                                android:textStyle="bold" />
                        </TableRow>
                    </TableLayout>

                    <LinearLayout
                        android:id="@+id/emptyStateLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="28dp"
                        android:paddingBottom="20dp"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:background="@drawable/bg_home_empty_illustration"
                            android:foregroundGravity="center">

                            <ImageView
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_home_empty"
                                app:tint="@color/home_empty_tint" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="这一天暂时没有课程"
                            android:textColor="@color/home_text_primary"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:maxWidth="260dp"
                            android:text="你可以切换日期重新查询，或确认学号是否填写正确。"
                            android:textColor="@color/home_text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/drawer_container"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/white"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <include
            android:id="@+id/drawer_header"
            layout="@layout/drawer_header" />

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/white"
            app:menu="@menu/drawer_menu"
            app:itemTextColor="@color/drawer_item_color_selector"
            app:itemIconTint="@color/drawer_icon_color_selector" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/home_card_border" />

        <include
            android:id="@+id/drawer_footer"
            layout="@layout/drawer_footer" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
